{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "Representa uma postagem no calendário editorial de qualquer empresa gerenciada.",
      "type": "object",
      "properties": {
        "empresa": {
          "type": "string",
          "description": "Nome da empresa ou cliente da postagem",
          "minLength": 1,
          "maxLength": 120
        },
        "data": {
          "type": "string",
          "description": "Data programada da postagem no formato YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "formato": {
          "type": "string",
          "description": "Formato da publicação (Reels, Carrossel, Post Estático, Stories, Vídeo Longo, Artigo / Blog, Newsletter)",
          "enum": [
            "Reels",
            "Carrossel",
            "Post Estático",
            "Stories",
            "Vídeo Longo",
            "Artigo / Blog",
            "Newsletter"
          ],
          "minLength": 1,
          "maxLength": 60
        },
        "objetivo": {
          "type": "string",
          "description": "Objetivo estratégico da postagem",
          "minLength": 1,
          "maxLength": 200
        },
        "conteudo": {
          "type": "string",
          "description": "Descrição detalhada ou copy do conteúdo da postagem",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Status editorial atual da postagem",
          "enum": [
            "Pendente",
            "Em Produção",
            "Em Aprovação",
            "Aprovado",
            "Publicado"
          ],
          "minLength": 1,
          "maxLength": 40
        },
        "responsavel": {
          "type": "string",
          "description": "Nome do profissional responsável pela postagem",
          "minLength": 1,
          "maxLength": 120
        },
        "briefing_url": {
          "type": "string",
          "description": "URL do documento de briefing ou materiais de referência",
          "minLength": 0,
          "maxLength": 500
        },
        "workspace": {
          "type": "string",
          "description": "Identificador do workspace editorial compartilhado entre os administradores",
          "enum": [
            "editorial_admin"
          ],
          "minLength": 15,
          "maxLength": 15
        },
        "createdBy": {
          "type": "string",
          "description": "UID do usuário autenticado que criou o post",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedBy": {
          "type": "string",
          "description": "UID do último usuário autenticado que atualizou o post",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp de criação no servidor"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp da última atualização no servidor"
        }
      },
      "required": [
        "empresa",
        "data",
        "formato",
        "objetivo",
        "conteudo",
        "status",
        "responsavel",
        "briefing_url",
        "workspace",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/Post"
      },
      "description": "Coleção principal de postagens do calendário editorial acessível por administradores autenticados."
    }
  }
}
